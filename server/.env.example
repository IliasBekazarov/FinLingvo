# PostgreSQL connection (Render provides this automatically)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public"

# JWT secrets — generate strong random strings for production
JWT_SECRET="change_this_to_a_strong_random_secret_min_32_chars"
JWT_REFRESH_SECRET="change_this_to_another_strong_random_secret"

# Server
PORT=4000
NODE_ENV=production

# Your Vercel frontend URL (add after deploying frontend)
CLIENT_URL=https://your-app.vercel.app
